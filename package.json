{
  "name": "claude-pet",
  "version": "0.5.5",
  "private": true,
  "description": "A local desktop creature that visualizes Claude Code's observable activity.",
  "license": "MIT",
  "author": "Vincent Cruvellier (https://github.com/r45635)",
  "contributors": [
    "Chloé Cruvellier (https://github.com/ChloeCru)"
  ],
  "repository": "github:r45635/claude-pet",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --experimental-test-isolation=none packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sim": "node packages/simulator/src/cli.ts",
    "daemon": "node packages/collector/src/daemon.ts",
    "snapshot": "node packages/collector/src/snapshot.ts",
    "doctor": "node packages/collector/src/doctor.ts",
    "otel": "node packages/collector/src/otel.ts",
    "install-hooks": "node packages/collector/src/install.ts install",
    "uninstall-hooks": "node packages/collector/src/install.ts uninstall",
    "autostart": "node packages/collector/src/autostart.ts",
    "fetch-widget": "node packages/collector/src/widget.ts fetch",
    "build-standalone": "node scripts/build-standalone.ts",
    "replay": "node packages/simulator/src/replay.ts",
    "avatar": "node scripts/avatar.ts",
    "avatars": "node packages/collector/src/avatars-cli.ts",
    "bench": "node scripts/bench.ts",
    "test:avatar-sanitizer": "node scripts/avatar-sanitize-check.ts",
    "docs:config": "node scripts/config-doc.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0"
  }
}
