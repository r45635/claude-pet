{
  "_comment": "The .claudepet avatar format: one source of truth for the creator tooling (avatar-format.ts) and the widget's import (src-tauri/src/avatars.rs, via include_str!). See docs/AVATARS.md.",
  "format": 1,
  "idPattern": "^[a-z0-9][a-z0-9-]{0,39}$",
  "builtin": ["classic"],
  "states": ["IDLE", "THINKING", "READING", "CODING", "TOOL_CALL", "HIGH_LOAD", "WAITING", "DONE", "ERROR"],
  "fallback": {
    "THINKING": "ACTIVE",
    "READING": "ACTIVE",
    "CODING": "ACTIVE",
    "TOOL_CALL": "ACTIVE",
    "HIGH_LOAD": "ACTIVE",
    "ERROR": "ACTIVE",
    "ACTIVE": "IDLE",
    "WAITING": "ACTIVE",
    "DONE": "IDLE"
  },
  "imageTypes": {
    "png": "image/png",
    "gif": "image/gif",
    "webp": "image/webp",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "svg": "image/svg+xml"
  },
  "limits": {
    "files": 40,
    "fileBytes": 2097152,
    "totalBytes": 10485760,
    "manifestBytes": 65536
  },
  "defaults": {
    "feet": [80, 146],
    "why": [66, 26],
    "hitbox": { "cx": 80, "cy": 92, "rx": 48, "ry": 52 }
  }
}
