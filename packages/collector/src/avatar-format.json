{
  "_comment": "The .claudepet avatar format: one source of truth for the creator tooling (avatar-format.ts) and the widget's import (src-tauri/src/avatars.rs, via include_str!). See docs/AVATARS.md.",
  "format": 1,
  "idPattern": "^[a-z0-9][a-z0-9-]{0,39}$",
  "builtin": ["classic"],
  "states": ["IDLE", "THINKING", "READING", "CODING", "TOOL_CALL", "HIGH_LOAD", "WAITING", "DONE", "ERROR"],
  "fallback": {
    "THINKING": "ACTIVE",
    "READING": "ACTIVE",
    "CODING": "ACTIVE",
    "TOOL_CALL": "ACTIVE",
    "HIGH_LOAD": "ACTIVE",
    "ERROR": "ACTIVE",
    "ACTIVE": "IDLE",
    "WAITING": "ACTIVE",
    "DONE": "IDLE"
  },
  "imageTypes": {
    "png": "image/png",
    "gif": "image/gif",
    "webp": "image/webp",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "svg": "image/svg+xml"
  },
  "limits": {
    "files": 40,
    "fileBytes": 2097152,
    "totalBytes": 10485760,
    "manifestBytes": 65536
  },
  "animations": {
    "profiles": ["classic"],
    "targets": ["root", "shaker", "body", "eyes"],
    "keyframePattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$",
    "builtinKeyframes": ["breathe", "shake", "nod", "tap", "hammer", "float", "cheer", "hop", "flinch", "step-l", "step-r"],
    "easings": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"],
    "bezierRange": [-0.5, 1.5],
    "durMs": [80, 10000],
    "ampRange": [0, 3],
    "maxCount": 10
  },
  "cssForbidden": ["@import", "@font-face", "@namespace", "@charset", "javascript:", "expression(", "</", "\\"],
  "defaults": {
    "feet": [80, 146],
    "why": [66, 26],
    "hitbox": { "cx": 80, "cy": 92, "rx": 48, "ry": 52 }
  }
}
